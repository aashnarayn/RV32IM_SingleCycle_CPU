
00a00293   // 1. ADDI x5, x0, 10    (x5 = 10)
00400313   // 2. ADDI x6, x0, 4     (x6 = 4)
06400393   // 3. ADDI x7, x0, 100   (x7 = 100)

// --- TEST 1: Register MAC (funct3 = 000) ---
// x7 = 100 + (10 * 4) = 140
0062838B   // 4. mac x7, x5, x6     

// --- TEST 2: Immediate MAC (funct3 = 001) ---
// x7 = 140 + (10 * 4) = 180
// Notice the '9' in the middle - that's the funct3 bit flipping!
0042938B   // 5. maci x7, x5, 4     

00000013   // 6. NOP
